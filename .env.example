# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_key_here

# Optional: fallback Gemini key — used automatically when the primary key is
# expired, invalid, or quota-exhausted (401/403/429 before any token).
# GOOGLE_GENERATIVE_AI_API_KEY_2=your_fallback_key_here

# Optional: override the Gemini model id (default: gemini-3.5-flash)
# GOOGLE_GENERATIVE_AI_MODEL=gemini-3.5-flash

# Optional: OpenRouter key (get one at https://openrouter.ai/keys) — serves as
# the final fallback provider when every Google key is unavailable. Uses a
# free Nemotron chat model by default.
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Optional: fallback OpenRouter key — used when the primary is invalid or
# rate-limited.
# OPENROUTER_API_KEY_2=sk-or-v1-yyyyyyyyyyyyyyyy

# Optional: override the OpenRouter model id.
# NOTE: nvidia/nemotron-3-embedd-1b is an EMBEDDING model and cannot chat.
# OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
